{
  "name": "sams-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "nodemon src/server.ts",
    "worker:screening": "ts-node src/queues/screening/screeningWorker.ts",
    "worker:normalization": "ts-node src/queues/applicationNormalization/normalizationWorker.ts",
    "seed:admin": "ts-node-dev ./src/seed/admin.seed.ts seed",
    "seed:misc": "ts-node-dev ./src/seed/miscellaneous.seed.ts seed",
    "seed:office": "ts-node-dev ./src/seed/office.seed.ts seed",
    "seed:province": "ts-node-dev ./src/seed/address.seed.ts -province",
    "seed:district": "ts-node-dev ./src/seed/address.seed.ts -district",
    "seed:municipality": "ts-node-dev ./src/seed/address.seed.ts -municipality",
    "seed:ward": "ts-node-dev ./src/seed/address.seed.ts -ward",
    "seed": "yarn seed:province && yarn seed:district && yarn seed:municipality && yarn seed:ward && yarn seed:admin && yarn seed:misc",
    "prisma:generate": "pnpm ts-node ./types/generate-types.ts && cp -r ./types/prisma-types.ts ../BAMS-frontend/src/types/prisma.types.ts",
    "seed:address": "yarn seed:province && yarn seed:district && yarn seed:municipality && yarn seed:ward",
    "db:push": "npx prisma db push"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
