generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String             @id @default(uuid())
  name                     String
  nameNp                   String?
  email                    String?
  password                 String
  phone                    String             @unique
  role                     ROLE               @default(USER)
  gender                   GENDER             @default(MALE)
  isBlocked                Boolean            @default(false)
  isDeactivated            Boolean            @default(false)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  deletedAt                DateTime?
  createdById              String?
  isDummyAccount           Boolean            @default(false)
  requireLoginVerification Boolean            @default(false)
  application              Application[]      @relation("createdByUser")
  auditLog                 AuditLog[]
  bulkOperationLog         BulkOperationLog[]
  applicationsByAdmin      Application[]      @relation("createdByAdmin")
}

model Media {
  id                String       @id @default(uuid())
  name              String?
  url               String?
  mimeType          String?
  mediaType         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
  applicationId     String?
  proposerId        String?
  resourceId        String?
  committeeMemberId String?
  memberId          String?
  application       Application? @relation(fields: [applicationId], references: [id])
  resource          Resource?    @relation(fields: [resourceId], references: [id])
}

model ApplicationCycle {
  id           String        @id @default(uuid())
  name         String?
  startDate    DateTime?
  endDate      DateTime?
  isDisabled   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  application  Application[]
  codeCounters CodeCounter[]
}

model Application {
  id                                String             @id @default(uuid())
  applicationCode                   String?
  applicantName                     String
  applicantNameNp                   String?
  citizenshipNumber                 String?
  issuedDate                        String?
  issuedDistrict                    String?
  addressId                         Int                @unique
  telephone                         String?
  email                             String?
  dateOfBirth                       String?
  educationQualification            String?
  profession                        String?
  fatherName                        String?
  fatherProfession                  String?
  useOfModernTechnology             Boolean?           @default(false)
  possibilityOfSellingProducedGoods Boolean?           @default(false)
  institutionalUpgradeSupport       Boolean?           @default(false)
  existingOperatingProfession       String?
  estimatedCost                     Float?
  submissionDate                    String?
  createdAt                         DateTime           @default(now())
  updatedAt                         DateTime           @updatedAt
  deletedAt                         DateTime?
  status                            APPLICATION_STATUS @default(REGISTERED)
  // program type
  entrepreneurshipRelatedTraining   Json[]
  professionToBeUpgraded            String[]
  programType                       PROGRAM_TYPE       @default(ENTREPRENEURSHIP_DEVELOPMENT)
  //
  applicationCycleId                String?
  userId                            String?
  createdByAdminId                  String?
  bulkOperationLogId                String?
  //
  applicationCycle                  ApplicationCycle?  @relation(fields: [applicationCycleId], references: [id], onDelete: Restrict)
  address                           Address            @relation(fields: [addressId], references: [id])
  user                              User?              @relation("createdByUser", fields: [userId], references: [id], onDelete: Cascade)
  media                             Media[]
  statusHistory                     StatusHistory[]
  createdByAdmin                    User?              @relation("createdByAdmin", fields: [createdByAdminId], references: [id])
  bulkOperationLog                  BulkOperationLog?  @relation(fields: [bulkOperationLogId], references: [id])

  @@unique([userId, applicationCycleId, programType], map: "unique_user_cycle_program_idx")
  @@unique([applicationCode, applicationCycleId], map: "unique_code_cycle_idx")
}

enum PROGRAM_TYPE {
  ENTREPRENEURSHIP_DEVELOPMENT
  TECHNOLOGY_UPGRADATION
}

model CodeCounter {
  id                 String           @id @default(uuid())
  prefix             String
  applicationCycleId String
  lastValue          Int              @default(0)
  applicationCycle   ApplicationCycle @relation(fields: [applicationCycleId], references: [id], onDelete: Cascade)

  @@unique([prefix, applicationCycleId])
}

model StatusHistory {
  id            String      @id @default(uuid())
  userId        String?
  oldStatus     String?
  newStatus     String?
  remark        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Address {
  id             Int           @id @default(autoincrement())
  provinceId     Int?
  districtId     Int?
  municipalityId Int?
  wardId         Int?
  locality       String?
  application    Application?
  district       District?     @relation(fields: [districtId], references: [id])
  municipality   Municipality? @relation(fields: [municipalityId], references: [id])
  province       Province?     @relation(fields: [provinceId], references: [id])
  ward           Ward?         @relation(fields: [wardId], references: [id])

  @@map("address")
}

model Province {
  id                  Int        @id
  provinceTitle       String     @map("province_title")
  provinceTitleNepali String     @map("province_title_nepali")
  code                Int
  cbs_code            Int?
  createdAt           DateTime?  @default(now()) @map("created_at")
  updatedAt           DateTime?  @updatedAt @map("updated_at")
  address             Address[]
  district            District[]

  @@map("province")
}

model District {
  id                  Int            @id
  provinceId          Int            @map("province_id")
  districtTitle       String         @map("district_title")
  districtTitleNepali String         @map("district_title_nepali")
  code                Int
  cbs_code            Int?
  createdAt           DateTime?      @default(now()) @map("created_at")
  updatedAt           DateTime?      @updatedAt @map("updated_at")
  address             Address[]
  province            Province       @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  municipality        Municipality[]

  @@map("district")
}

model Municipality {
  id                      Int       @id
  districtId              Int       @map("district_id")
  municipalityTitle       String    @map("municipality_title")
  municipalityTitleNepali String    @map("municipality_title_nepali")
  code                    Int
  cbs_code                Int?
  hlcit_code              String?
  type                    String?
  createdAt               DateTime? @default(now()) @map("created_at")
  updatedAt               DateTime? @updatedAt @map("updated_at")
  address                 Address[]
  district                District  @relation(fields: [districtId], references: [id], onDelete: Cascade)
  ward                    Ward[]

  @@map("municipality")
}

model Ward {
  id               Int          @id
  municipalityId   Int          @map("municipality_id")
  wardNumber       Int          @map("ward_number")
  wardNumberNepali String?      @map("ward_number_nepali")
  hlcit_code       String?
  createdAt        DateTime?    @default(now()) @map("created_at")
  updatedAt        DateTime?    @updatedAt @map("updated_at")
  address          Address[]
  municipality     Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  @@map("ward")
}

model SMS {
  id          String     @id @default(uuid())
  messageText String
  messageType String
  phone       String
  smsStatus   SMS_STATUS @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model OTP {
  id         String   @id @default(uuid())
  otp        String
  phone      String
  name       String?
  password   String?
  otpType    OTP_TYPE @default(REGISTER)
  expiryTime DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  gender     String?
}

model Resource {
  id        String    @id @default(uuid())
  fileName  String
  key       String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  media     Media[]
}

model AuditLog {
  id        String   @id @default(uuid())
  model     String
  recordId  String?
  action    String?
  userId    String?
  changes   Json?
  duration  Int?
  createdAt DateTime @default(now())
  remarks   String?
  user      User?    @relation(fields: [userId], references: [id])
}

model BulkOperationLog {
  id                     String                  @id @default(uuid())
  operationType          BULK_OPERATION_TYPE     @default(LOAN_RECIPIENT_UPLOAD)
  totalCount             Int?
  duration               Int?                    @default(0)
  isReversed             Boolean                 @default(false)
  reversedAt             DateTime?
  createdAt              DateTime                @default(now())
  triggeredById          String?
  triggeredBy            User?                   @relation(fields: [triggeredById], references: [id])
  applications           Application[]
  bulkOperationRowErrors BulkOperationRowError[]
}

model BulkOperationRowError {
  id               String           @id @default(uuid())
  bulkOperationId  String
  bulkOperation    BulkOperationLog @relation(fields: [bulkOperationId], references: [id], onDelete: Cascade)
  rowNumber        Int // Excel row number (e.g., 5, 12, 1034)
  uniqueIdentifier String? // e.g. citizenId, email, loanNo
  errorMessage     String // human-readable message
  rawRowData       Json? // optional: original row snapshot
  createdAt        DateTime         @default(now())

  @@index([bulkOperationId])
}

enum BULK_OPERATION_TYPE {
  LOAN_RECIPIENT_UPLOAD
  APPLICATION_UPLOAD
}

enum ROLE {
  SUDO_ADMIN
  SUPER_ADMIN
  ADMIN
  USER
  DATA_ENTRY
  COMMITTEE_ADMIN
}

enum GENDER {
  MALE
  FEMALE
  OTHER
}

enum APPLICATION_STATUS {
  REGISTERED
  APPROVED
  REJECTED
}

enum SMS_STATUS {
  PENDING
  SENT
  FAILED
}

enum OTP_TYPE {
  REGISTER
  PASSWORD_RESET
  LOGIN_VERIFY
}
